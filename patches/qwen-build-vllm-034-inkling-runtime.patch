+++ b/engine/direct-xpu-034-inkling/install-inkling.py
@@ -0,0 +1,44 @@
+"""Bind the freshly built PTI libraries and EXL3 _C.so into the Inkling 0.34 runtime.
+
+Inkling needs only the native _C.so (exl3xpu_C::exl3_sdpa) and oneDNN; no vLLM
+source overrides and no exl3xpu Python package are installed.
+"""
+import hashlib
+import json
+from pathlib import Path
+import shutil
+
+ROOT = Path('/opt/b70-direct')
+ENGINE = Path('/opt/exl3xpu/exl3xpu')
+TORCH_INIT = Path('/opt/venv/lib/python3.12/site-packages/torch/__init__.py')
+
+
+def sha(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def main():
+    lock = json.loads((ROOT / 'build-lock.json').read_text())
+    sources = json.loads((ROOT / 'source-manifest.json').read_text())
+    for name, expected in sources['files_sha256'].items():
+        if sha(ROOT / name) != expected:
+            raise RuntimeError('Unreviewed integration source: ' + name)
+    if sha(TORCH_INIT) != lock['pristine_torch_init_sha256']:
+        raise RuntimeError('Unexpected modification to official Torch loader')
+    pti = json.loads(Path('/native/pti-patch.json').read_text())
+    assert pti['base_commit'] == lock['sources']['pti']['commit']
+    assert pti['fix_commit'] == lock['sources']['pti']['fix_commit']
+    for path, expected in pti['library_sha256'].items():
+        assert sha(path) == expected, path
+    (ROOT / 'pti-patch.json').write_text(json.dumps(pti, indent=2) + '\n')
+    ENGINE.mkdir(parents=True, exist_ok=True)
+    for name in ('_C.so', '_C.so.manifest.json'):
+        shutil.copyfile(Path('/native') / name, ENGINE / name)
+    (ROOT / 'installation.json').write_text(json.dumps({
+        'status': 'INSTALLED_BUILD_NOT_QUALIFIED', 'variant': 'inkling-vllm034',
+        'native_C_sha256': sha(ENGINE / '_C.so'), 'native_gpu_tests_executed': False,
+    }, indent=2) + '\n')
+
+
+if __name__ == '__main__':
+    main()
